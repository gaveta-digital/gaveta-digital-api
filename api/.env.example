PORT=8080
NODE_ENV=development
DB_DIALECT=sqlite
DB_STORAGE=./data/database.sqlite
JWT_SECRET=troque-por-uma-chave-secreta
# Provedor de IA (Groq, no formato da OpenAI). Gere a chave em https://console.groq.com/keys
IA_BASE_URL=https://api.groq.com/openai/v1
IA_API_KEY=
# Modelos separados por vírgula; se um falhar, a API tenta o próximo
# Os modelos precisam aceitar imagem e o parâmetro reasoning_effort (padrão: qwen/qwen3.8-27b)
IA_MODELOS=qwen/qwen3.8-27b
